<ScrollView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:padding="16dp"
    android:background="@android:color/white">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <TextView
            android:id="@+id/tvGreeting"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="สวัสดี"
            android:textSize="20sp"
            android:textStyle="bold"
            android:padding="12dp"
            android:background="#1A000000"
            android:layout_marginBottom="8dp"/>

        <com.google.android.material.card.MaterialCardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            app:cardBackgroundColor="?attr/colorSurface"
            app:strokeColor="?attr/colorOutline"
            app:strokeWidth="1dp"
            app:cardElevation="2dp"
            app:cardCornerRadius="12dp"
            android:layout_margin="12dp"
            android:padding="16dp">

        <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical">


                <TextView
                    android:id="@+id/txtMedCount"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="ยาทั้งหมด: 0 รายการ"
                    android:paddingStart="20dp"
                    android:paddingTop="12dp"
                    android:textColor="@android:color/black"
                    android:textSize="18sp"
                    android:layout_marginBottom="8dp" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="ยาที่ต้องกินถัดไปวันนี้"
                    android:paddingStart="20dp"
                    android:textColor="@android:color/black"
                    android:textSize="16sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/txtNextName"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="—"
                    android:textColor="@android:color/black"
                    android:textSize="20sp"
                    android:layout_marginTop="6dp"
                    android:paddingStart="20dp"/>

                <TextView
                    android:id="@+id/txtNextTime"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="—"
                    android:textColor="@android:color/black"
                    android:textSize="18sp"
                    android:layout_marginTop="2dp"
                    android:paddingStart="20dp"
                    android:paddingBottom="12dp"/>
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <!-- ปฏิทิน -->
        <CalendarView
            android:id="@+id/calendarView"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@android:color/white"
            android:layout_marginBottom="16dp"
            android:weekSeparatorLineColor="@android:color/transparent"
            android:focusedMonthDateColor="@android:color/black"
            android:unfocusedMonthDateColor="@android:color/darker_gray"
            android:weekDayTextAppearance="@style/TextAppearance.Material3.BodyMedium"
            android:dateTextAppearance="@style/TextAppearance.Material3.BodyMedium" />

        <!-- ปุ่ม -->
        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnAddMed"
            style="@style/Widget.MaterialComponents.Button"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="เพิ่มยา"
            android:layout_marginBottom="8dp"/>

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnSeeAll"
            style="@style/Widget.MaterialComponents.Button.OutlinedButton"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="ดูรายการยา"/>

    </LinearLayout>
</ScrollView>
