<?xml version="1.0" encoding="utf-8"?>
<androidx.coordinatorlayout.widget.CoordinatorLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/coordinator"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <ScrollView
        android:id="@+id/scroll"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:padding="16dp"
        android:paddingBottom="120dp"
        android:layout_marginBottom="@dimen/fab_raise_from_bottom">

        <LinearLayout
            android:orientation="vertical"
            android:layout_width="match_parent"
            android:layout_height="wrap_content">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Your Caregivers"
                android:textStyle="bold"
                android:textSize="16sp"/>

            <TextView
                android:id="@+id/tvEmptyCaregivers"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="ยังไม่มีผู้ดูแล"
                android:visibility="gone"
                android:paddingTop="8dp"/>

            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/rvCaregivers"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:nestedScrollingEnabled="false"
                android:paddingBottom="12dp"/>

            <View
                android:layout_width="match_parent"
                android:layout_height="1dp"
                android:background="#22000000"
                android:layout_marginVertical="12dp"/>

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="People you care for"
                android:textStyle="bold"
                android:textSize="16sp"/>

            <TextView
                android:id="@+id/tvEmptyPatients"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="ยังไม่มีผู้ที่คุณดูแล"
                android:visibility="gone"
                android:paddingTop="8dp"/>

            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/rvPatients"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:nestedScrollingEnabled="false"/>

            <com.google.android.material.floatingactionbutton.FloatingActionButton
                android:id="@+id/fabInvite"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="bottom|end"
                android:layout_marginEnd="16dp"
                android:layout_marginBottom="84dp"
                android:contentDescription="@string/invite"
                app:backgroundTint="?attr/colorPrimary"
                app:srcCompat="@android:drawable/ic_input_add"
                app:tint="@android:color/white"
                app:useCompatPadding="true" />
        </LinearLayout>
    </ScrollView>

</androidx.coordinatorlayout.widget.CoordinatorLayout>
