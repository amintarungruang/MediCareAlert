<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:padding="12dp"
    android:background="@drawable/bg_list_cell">

    <!-- ชื่อยา -->
    <TextView
        android:id="@+id/tvName"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:textStyle="bold"
        android:textSize="16sp"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toStartOf="@id/btnMore"
        app:layout_constraintHorizontal_bias="0"
        android:maxLines="1"
        android:ellipsize="end"/>

    <!-- ขนาดยา/โน้ตสั้น -->
    <TextView
        android:id="@+id/tvDose"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:textColor="#666"
        app:layout_constraintTop_toBottomOf="@id/tvName"
        app:layout_constraintStart_toStartOf="@id/tvName"
        app:layout_constraintEnd_toEndOf="@id/tvName"
        android:maxLines="1"
        android:ellipsize="end"/>

    <!-- เวลา -->
    <com.google.android.material.chip.Chip
        android:id="@+id/chipTime"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        style="@style/Widget.Material3.Chip.Assist.Elevated"
        app:layout_constraintTop_toBottomOf="@id/tvDose"
        app:layout_constraintStart_toStartOf="@id/tvDose"
        android:layout_marginTop="8dp"
        android:text="08:00"/>

    <!-- ปุ่มกินแล้ว -->

    <!-- เมนู 3 จุด -->
    <com.google.android.material.button.MaterialButton
        android:id="@+id/btnTaken"
        android:layout_width="wrap_content"
        android:layout_height="40dp"
        android:text="กินแล้ว"
        app:cornerRadius="20dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintVertical_bias="0.737" />

    <ImageButton
        android:id="@+id/btnMore"
        android:layout_width="36dp"
        android:layout_height="36dp"
        android:background="?attr/selectableItemBackgroundBorderless"
        android:contentDescription="@string/more"
        app:srcCompat="@drawable/ic_more_vert_24"
        app:tint="?attr/colorOnSurfaceVariant"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintEnd_toEndOf="parent"/>
</androidx.constraintlayout.widget.ConstraintLayout>
